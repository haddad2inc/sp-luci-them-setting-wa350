# A-HADDAD Dashboard integration for OpenWrt 24.10 / LuCI ucode
# Copy this fragment into the OpenWrt buildroot .config, then run:
#   make defconfig
# Keep the existing target/profile selections from your main .config.

CONFIG_PACKAGE_luci-theme-enan-dashboard=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

# Required by the A-HADDAD ucode and dashboard runtime
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-rtnl=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_iwinfo=y

# Wireless and Mesh support for the ath79 CF-WA350 profile
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y
CONFIG_PACKAGE_wpad=y
CONFIG_PACKAGE_mesh11sd=y

# Keep at least one LuCI theme package because LuCI cbi.js is supplied by
# luci-base; A-HADDAD is selected as the active theme by its uci-defaults script.
CONFIG_PACKAGE_luci-theme-bootstrap=y
